# Variabel untuk docker-compose.yml (deployment, BUKAN untuk dev lokal —
# untuk dev lokal isi backend/.env, bukan file ini).
#
# Cara pakai: cp .env.example .env, lalu isi nilainya, letakkan di root repo
# (sejajar dengan docker-compose.yml) di server.

# Domain yang sudah diarahkan (DNS A record) ke IP VPS ini — wajib untuk
# HTTPS otomatis (Let's Encrypt) via Caddy. Kamera browser tidak akan bisa
# diakses tanpa HTTPS.
DOMAIN=isyaratlive.contoh-domain.com

# Email untuk notifikasi sertifikat Let's Encrypt (expiry, dsb)
ACME_EMAIL=kamu@contoh-domain.com

# Password MySQL — buat sendiri, jangan pakai nilai contoh ini
MYSQL_ROOT_PASSWORD=ganti-dengan-password-kuat
MYSQL_PASSWORD=ganti-dengan-password-kuat-juga
